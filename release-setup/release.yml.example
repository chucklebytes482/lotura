name: Lotura permanent-key release
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: write
concurrency:
  group: android-release-${{ github.ref }}
  cancel-in-progress: false
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.3.1'
      - name: Version (preserve monotonic code when replacing workflow)
        env:
          GH_TOKEN: ${{ github.token }}
        shell: bash
        run: |
          set -euo pipefail
          # Old workflow uses 1 + run_number. Check tags to avoid restarting versioning.
          MAX=$(gh api --paginate "repos/$GITHUB_REPOSITORY/tags?per_page=100" --jq '.[].name' | sed -nE 's/^v1\.0\.([0-9]+)$/\1/p' | sort -n | tail -n 1)
          NEXT=$(( ${MAX:-0} + 1 ))
          if (( GITHUB_RUN_NUMBER > NEXT )); then NEXT=$GITHUB_RUN_NUMBER; fi
          echo "CI_VERSION_CODE=$((1 + NEXT))" >> "$GITHUB_ENV"
          echo "CI_VERSION_NAME=1.0.$NEXT" >> "$GITHUB_ENV"
          echo "VERSION_TAG=v1.0.$NEXT" >> "$GITHUB_ENV"
      - name: Android SDK
        shell: bash
        run: |
          set -euo pipefail
          SDK_DIR="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-/usr/local/lib/android/sdk}}"
          SDKMANAGER=$(find "$SDK_DIR/cmdline-tools" -name sdkmanager -type f | sort -V | tail -n 1)
          test -n "$SDKMANAGER"
          (yes || true) | "$SDKMANAGER" --licenses >/dev/null
          "$SDKMANAGER" 'platform-tools' 'platforms;android-36' 'platforms;android-36.1' 'build-tools;36.0.0'
          echo "ANDROID_HOME=$SDK_DIR" >> "$GITHUB_ENV"
      - name: Require permanent signing key
        env:
          RELEASE_KEYSTORE_BASE64: ${{ secrets.RELEASE_KEYSTORE_BASE64 }}
          STORE_PASSWORD: ${{ secrets.STORE_PASSWORD }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          for VAR in RELEASE_KEYSTORE_BASE64 STORE_PASSWORD KEY_PASSWORD KEY_ALIAS; do
            if [[ -z "${!VAR}" ]]; then echo "::error::Missing signing secret: $VAR"; exit 1; fi
          done
          # The application's protected signing configuration expects alias upload.
          [[ "$KEY_ALIAS" == upload ]] || { echo '::error::KEY_ALIAS must be upload'; exit 1; }
          printf '%s' "$RELEASE_KEYSTORE_BASE64" | base64 --decode > "$RUNNER_TEMP/upload.jks"
          keytool -list -keystore "$RUNNER_TEMP/upload.jks" -alias upload -storepass:env STORE_PASSWORD >/dev/null
          echo "KEYSTORE_PATH=$RUNNER_TEMP/upload.jks" >> "$GITHUB_ENV"
          if [[ ! -f debug.keystore ]]; then
            test -f debug.keystore.base64
            base64 --decode < debug.keystore.base64 > debug.keystore
          fi
      - name: Unit and Robolectric tests
        run: gradle :app:testDebugUnitTest --no-daemon --stacktrace
      - name: Build R8 arm64 APK
        env:
          STORE_PASSWORD: ${{ secrets.STORE_PASSWORD }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: gradle :app:assembleRelease --no-daemon --stacktrace
      - name: Verify signature and package
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p dist
          APK="lotura-${VERSION_TAG}-arm64-v8a-release.apk"
          cp app/build/outputs/apk/release/app-release.apk "dist/$APK"
          "$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --verbose --print-certs "dist/$APK" | tee dist/CERT_FINGERPRINT.txt
          # Require the APK certificate to match the documented permanent key.
          EXPECTED=$(sed -n 's/^SHA-256: //p' release-setup/CERT_FINGERPRINT.txt | tr -d ':' | tr '[:upper:]' '[:lower:]')
          ACTUAL=$(sed -n 's/.*certificate SHA-256 digest: //p' dist/CERT_FINGERPRINT.txt | sort -u)
          [[ -n "$EXPECTED" && "$ACTUAL" == "$EXPECTED" ]] || { echo '::error::Unexpected APK signing certificate'; exit 1; }
          (cd dist && sha256sum "$APK" > CHECKSUMS.txt)
      - uses: actions/upload-artifact@v4
        with:
          name: lotura-release
          path: dist/*
      - uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ env.VERSION_TAG }}
          name: Lotura ${{ env.VERSION_TAG }}
          files: dist/*
          generate_release_notes: true
      - name: Clean private key
        if: always()
        shell: bash
        run: rm -f "$RUNNER_TEMP/upload.jks"